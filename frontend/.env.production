# Same-origin /api when the SPA is served from snagdesk.cravingcodetech.in
# (nginx proxies /api → Node). Avoids cross-origin + self-signed cert prompts.
VITE_API_BASE_URL=/api
VITE_NATIVE_API_BASE_URL=https://snagdesk.cravingcodetech.in/api
VITE_APP_NAME=SnagDesk
VITE_MAX_IMAGE_SIZE_MB=10
VITE_MAX_IMAGES_PER_ITEM=5
