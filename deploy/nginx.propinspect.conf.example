# Example nginx site for PropInspect on the VPS.
# Copy to /etc/nginx/sites-available/propinspect and enable.
#
# SSL: terminate TLS here (self-signed or Let's Encrypt), proxy API to Node.

server {
    listen 80;
    listen 443 ssl;
    server_name 147.93.30.96;

    # ssl_certificate     /etc/ssl/certs/propinspect.crt;
    # ssl_certificate_key /etc/ssl/private/propinspect.key;

    root /home/deploy/apps/PropInspect/frontend/dist;
    index index.html;

    client_max_body_size 20M;

    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:4000/uploads/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
